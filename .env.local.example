# Copia este archivo a .env.local y completa los valores.

# API key gratis en https://serper.dev (2.500 búsquedas gratis, sin tarjeta)
SERPER_API_KEY=

# Cualquier cadena secreta que tú inventes. Debe coincidir con BUSCADOR_API_KEY
# en el archivo template_buscador_proveedores.html / el HTML ya generado.
SEARCH_SHARED_SECRET=
